// Cloudflare Workers config: serves the static site in sites/cloudflare.
// The "name" must match the Worker project name in the Cloudflare dashboard.
{
  "name": "www",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./sites/cloudflare",
    "not_found_handling": "404-page"
  }
}
